generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES
  SURVEYOR
  INSTALLATION
  ACCOUNTS
  SUPPORT
  VIEWER
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum CustomerCategory {
  RESIDENTIAL
  COMMERCIAL
}

enum EnquiryStatus {
  LEAD
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum EnquiryStage {
  NEW
  FOLLOW_UP_REQUIRED
  SITE_SURVEY_PENDING
  QUOTATION_PENDING
  QUOTATION_SENT
  ORDER_CONFIRMED
  INSTALLATION
  CLOSED
}

enum FollowUpType {
  CALL
  WHATSAPP
  MEETING
  SITE_VISIT
  EMAIL
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SurveyStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Feasibility {
  FEASIBLE
  FEASIBLE_WITH_CHANGES
  NOT_FEASIBLE
  PENDING
}

enum SolarSystemType {
  ON_GRID
  ON_GRID_MICRO
  HYBRID
  OFF_GRID
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  CONFIRMED
  ADVANCE_PENDING
  READY_FOR_INSTALLATION
  INSTALLATION_SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InstallationStatus {
  SCHEDULED
  IN_PROGRESS
  DELAYED
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  ALLOCATION
  RELEASE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  POSTED
  VOID
}

enum ServiceStatus {
  OPEN
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(SALES)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  assignedEnquiries     Enquiry[]           @relation("EnquiryAssignee")
  assignedFollowUps     FollowUp[]          @relation("FollowUpAssignee")
  assignedSurveys       SiteSurvey[]        @relation("SurveyAssignee")
  assignedInstallations InstallationMember[]
  assignedServices      ServiceRequest[]    @relation("ServiceAssignee")
  createdActivities     Activity[]
  notifications         Notification[]
  auditEntries          AuditLog[]
  createdStockMovements StockMovement[]     @relation("StockMovementActor")

  @@index([role, active])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  oauth_token_secret String?
  oauth_token       String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Customer {
  id              String           @id @default(cuid())
  name            String
  nameNormalized  String
  phone           String
  phoneNormalized String
  email           String?
  address         String?
  district        String?
  category        CustomerCategory @default(RESIDENTIAL)
  status          RecordStatus     @default(ACTIVE)
  propertyDetails Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?

  contacts       Contact[]
  enquiries      Enquiry[]
  followUps      FollowUp[]
  surveys        SiteSurvey[]
  quotations     Quotation[]
  orders         SalesOrder[]
  installations  Installation[]
  invoices       Invoice[]
  payments       Payment[]
  serviceRequests ServiceRequest[]
  documents      Document[]
  activities     Activity[]

  @@index([name])
  @@unique([phoneNormalized, nameNormalized])
  @@index([district, status])
}

model Contact {
  id             String   @id @default(cuid())
  name           String
  phone          String
  email          String?
  organization   String?
  designation    String?
  category       String?
  notes          String?
  customerId     String?
  enquiryId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  enquiry  Enquiry?  @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([enquiryId])
  @@index([phone])
}

model Enquiry {
  id                String        @id @default(cuid())
  siNo              Int           @unique
  name              String
  contactNo         String
  email             String?
  place             String
  district          String?
  category          CustomerCategory
  solarType         SolarSystemType?
  systemCapacityKw  Decimal?      @db.Decimal(10, 2)
  roofType          String?
  dcrType           String?
  panelBrand        String?
  inverterBrand     String?
  referral          String?
  referralContact   String?
  quotedAmount      Decimal?      @db.Decimal(14, 2)
  cashReceived      Decimal       @default(0) @db.Decimal(14, 2)
  documentation     Boolean       @default(false)
  startDate         DateTime?
  status            EnquiryStatus @default(LEAD)
  stage             EnquiryStage  @default(NEW)
  workDescription   String?
  source            String
  nextFollowUp      DateTime?
  customerId        String?
  assignedToId      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  archivedAt        DateTime?

  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo     User?          @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  contacts       Contact[]
  followUps      FollowUp[]
  surveys        SiteSurvey[]
  quotations     Quotation[]
  orders         SalesOrder[]
  installations  Installation[]
  invoices       Invoice[]
  serviceRequests ServiceRequest[]
  documents      Document[]
  activities     Activity[]

  @@index([status, stage])
  @@index([assignedToId, createdAt])
  @@index([customerId])
  @@index([contactNo])
  @@index([createdAt])
}

model FollowUp {
  id           String        @id @default(cuid())
  title        String
  enquiryId    String
  customerId   String
  assignedToId String?
  date         DateTime
  type         FollowUpType
  priority     Priority      @default(MEDIUM)
  status       FollowUpStatus @default(PENDING)
  notes        String?
  outcome      String?
  nextAction   String?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo User?    @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities Activity[]

  @@index([date, status])
  @@index([assignedToId, date])
  @@index([customerId, date])
}

model SiteSurvey {
  id                       String       @id @default(cuid())
  surveyNumber             String       @unique
  customerId               String
  enquiryId                String
  surveyorId               String?
  location                 String
  scheduledAt              DateTime
  completedAt              DateTime?
  propertyType             CustomerCategory
  roofType                 String
  roofCondition            String?
  roofAreaSqFt             Decimal?     @db.Decimal(12, 2)
  electricityConnection    String?
  sanctionedLoadKw         Decimal?     @db.Decimal(10, 2)
  monthlyConsumptionKwh    Decimal?     @db.Decimal(12, 2)
  averageBill              Decimal?     @db.Decimal(14, 2)
  proposedCapacityKw       Decimal?     @db.Decimal(10, 2)
  solarType                SolarSystemType?
  shadingDetails           String?
  installationArea         String?
  panelPlacementNotes      String?
  inverterLocation         String?
  batteryRequirements      String?
  cableRoutingNotes        String?
  electricalObservations   String?
  feasibility              Feasibility  @default(PENDING)
  status                   SurveyStatus @default(SCHEDULED)
  notes                    String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enquiry   Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  surveyor  User?      @relation("SurveyAssignee", fields: [surveyorId], references: [id], onDelete: SetNull)
  documents Document[]
  activities Activity[]

  @@index([scheduledAt, status])
  @@index([surveyorId, scheduledAt])
  @@index([customerId])
}

model Quotation {
  id                    String          @id @default(cuid())
  number                String          @unique
  customerId            String
  enquiryId             String
  solarType             SolarSystemType
  capacityKw            Decimal         @db.Decimal(10, 2)
  panelDetails          String?
  inverterDetails       String?
  batteryDetails        String?
  mountingStructure     String?
  installationCharges  Decimal         @default(0) @db.Decimal(14, 2)
  otherCharges          Decimal         @default(0) @db.Decimal(14, 2)
  discount              Decimal         @default(0) @db.Decimal(14, 2)
  taxPercent            Decimal         @default(0) @db.Decimal(5, 2)
  subtotal              Decimal         @default(0) @db.Decimal(14, 2)
  taxAmount             Decimal         @default(0) @db.Decimal(14, 2)
  subsidyEstimate       Decimal         @default(0) @db.Decimal(14, 2)
  totalAmount           Decimal         @default(0) @db.Decimal(14, 2)
  customerPayable       Decimal         @default(0) @db.Decimal(14, 2)
  validUntil            DateTime
  paymentTerms          String?
  notes                 String?
  status                QuotationStatus @default(DRAFT)
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enquiry    Enquiry             @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  items      QuotationItem[]
  revisions  QuotationRevision[]
  order      SalesOrder?
  activities Activity[]

  @@index([customerId, createdAt])
  @@index([enquiryId, status])
  @@index([status, validUntil])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  description String
  quantity    Decimal   @db.Decimal(12, 3)
  unit        String    @default("unit")
  unitPrice   Decimal   @db.Decimal(14, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)
  sortOrder   Int       @default(0)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, sortOrder])
}

model QuotationRevision {
  id          String   @id @default(cuid())
  quotationId String
  revision    Int
  snapshot    Json
  reason      String?
  createdAt   DateTime @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, revision])
}

model SalesOrder {
  id                    String      @id @default(cuid())
  number                String      @unique
  quotationId           String      @unique
  customerId            String
  enquiryId             String
  orderDate             DateTime    @default(now())
  expectedInstallation  DateTime?
  orderValue            Decimal     @db.Decimal(14, 2)
  advanceReceived       Decimal     @default(0) @db.Decimal(14, 2)
  status                OrderStatus @default(ADVANCE_PENDING)
  notes                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  quotation     Quotation          @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enquiry       Enquiry            @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  milestones    PaymentMilestone[]
  installations Installation[]
  invoices      Invoice[]
  payments      Payment[]
  stockMovements StockMovement[]
  activities    Activity[]

  @@index([customerId, orderDate])
  @@index([status, expectedInstallation])
}

model PaymentMilestone {
  id          String    @id @default(cuid())
  orderId     String
  name        String
  amount      Decimal   @db.Decimal(14, 2)
  dueDate     DateTime?
  paidAt      DateTime?
  sortOrder   Int       @default(0)
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, sortOrder])
}

model Installation {
  id                String             @id @default(cuid())
  installationNumber String            @unique
  orderId           String             @unique
  customerId        String
  enquiryId         String
  siteAddress       String
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  capacityKw        Decimal            @db.Decimal(10, 2)
  status            InstallationStatus @default(SCHEDULED)
  progressPercent   Int                @default(0)
  commissioningData Json?
  handoverNotes     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  order        SalesOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enquiry      Enquiry               @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  team         InstallationMember[]
  tasks        InstallationTask[]
  documents    Document[]
  serviceRequests ServiceRequest[]
  activities   Activity[]

  @@index([status, scheduledAt])
  @@index([customerId])
}

model InstallationMember {
  installationId String
  userId         String
  assignedAt     DateTime      @default(now())
  installation   Installation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([installationId, userId])
  @@index([userId])
}

model InstallationTask {
  id             String       @id @default(cuid())
  installationId String
  title          String
  description    String?
  completed      Boolean      @default(false)
  completedAt    DateTime?
  sortOrder      Int          @default(0)
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId, sortOrder])
}

model Product {
  id               String            @id @default(cuid())
  name             String
  sku              String            @unique
  brand            String?
  model            String?
  category         String
  specification    String?
  unit             String             @default("unit")
  purchasePrice    Decimal            @default(0) @db.Decimal(14, 2)
  sellingPrice     Decimal            @default(0) @db.Decimal(14, 2)
  minimumStock     Decimal            @default(0) @db.Decimal(12, 3)
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  movements StockMovement[]

  @@index([category, active])
  @@index([name])
}

model StockMovement {
  id              String           @id @default(cuid())
  productId       String
  orderId         String?
  performedById   String?
  type            StockMovementType
  quantity        Decimal          @db.Decimal(12, 3)
  quantityDelta   Decimal          @db.Decimal(12, 3)
  unitCost        Decimal?         @db.Decimal(14, 2)
  note            String?
  idempotencyKey  String?          @unique
  createdAt       DateTime         @default(now())

  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  order       SalesOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  performedBy User?      @relation("StockMovementActor", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  customerId    String
  enquiryId     String?
  orderId       String?
  issueDate     DateTime
  dueDate       DateTime
  subtotal      Decimal       @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  balanceDue    Decimal       @db.Decimal(14, 2)
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enquiry     Enquiry?           @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  order       SalesOrder?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items       InvoiceItem[]
  allocations PaymentAllocation[]

  @@index([customerId, issueDate])
  @@index([status, dueDate])
  @@index([orderId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String   @default("unit")
  unitPrice   Decimal  @db.Decimal(14, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  sortOrder   Int      @default(0)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
}

model Payment {
  id                String        @id @default(cuid())
  referenceNumber   String        @unique
  idempotencyKey    String        @unique
  customerId        String
  orderId           String?
  amount            Decimal       @db.Decimal(14, 2)
  paymentDate       DateTime
  method            PaymentMethod
  transactionRef    String?
  receivedBy        String?
  notes             String?
  status            PaymentStatus @default(POSTED)
  createdAt         DateTime      @default(now())

  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order       SalesOrder?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  receipt     Receipt?
  activities  Activity[]

  @@index([customerId, paymentDate])
  @@index([orderId])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model Receipt {
  id          String   @id @default(cuid())
  number      String   @unique
  paymentId   String   @unique
  issuedAt    DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model ServiceRequest {
  id               String        @id @default(cuid())
  number           String        @unique
  customerId       String
  enquiryId        String?
  installationId   String?
  assignedToId     String?
  complaintCategory String
  description      String
  reportedAt       DateTime      @default(now())
  priority         Priority      @default(MEDIUM)
  warrantyStatus   String?
  warrantyExpires  DateTime?
  appointmentAt    DateTime?
  resolutionNotes  String?
  partsReplaced    Json?
  serviceCharges   Decimal       @default(0) @db.Decimal(14, 2)
  closedAt         DateTime?
  status           ServiceStatus @default(OPEN)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enquiry      Enquiry?      @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  installation Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  assignedTo   User?         @relation("ServiceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  documents    Document[]
  activities   Activity[]

  @@index([status, priority, reportedAt])
  @@index([customerId, reportedAt])
  @@index([assignedToId, appointmentAt])
}

model Document {
  id                String   @id @default(cuid())
  fileName          String
  storageKey        String   @unique
  contentType       String
  sizeBytes         Int
  customerId        String?
  enquiryId         String?
  surveyId          String?
  installationId    String?
  serviceRequestId  String?
  uploadedById      String?
  createdAt         DateTime @default(now())

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  enquiry        Enquiry?        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  survey         SiteSurvey?     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  installation   Installation?   @relation(fields: [installationId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([enquiryId, createdAt])
  @@index([surveyId, createdAt])
  @@index([installationId, createdAt])
  @@index([serviceRequestId, createdAt])
}

model Activity {
  id              String        @id @default(cuid())
  customerId      String?
  enquiryId       String?
  followUpId      String?
  surveyId        String?
  quotationId     String?
  orderId         String?
  installationId String?
  paymentId       String?
  serviceRequestId String?
  createdById     String?
  kind            String
  text            String
  createdAt       DateTime      @default(now())

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  enquiry        Enquiry?        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  followUp       FollowUp?       @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  survey         SiteSurvey?     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  quotation      Quotation?      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  order          SalesOrder?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  installation   Installation?   @relation(fields: [installationId], references: [id], onDelete: Cascade)
  payment        Payment?        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([enquiryId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

model NumberSequence {
  name      String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ConfigOption {
  id        String   @id @default(cuid())
  category  String
  value     String
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category, active, sortOrder])
}
